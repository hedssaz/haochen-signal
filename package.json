{
  "name": "haochen-signal",
  "version": "0.1.0",
  "description": "以浩宸宇宙为交互语言的 AI 编程 CLI",
  "type": "module",
  "bin": {
    "haochen": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/index.tsx",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "haochen"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cross-spawn": "^7.0.6",
    "ink": "^6.8.0",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.13",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "undici": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
